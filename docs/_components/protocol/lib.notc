// 由 protocol/registry.json 构造方法表。数据由 just protocol 生成，表格在 Notist 构建期组装。
fn methods() -> BlockContent {
    let root = data_expect<Data>(read_json(p"../../../protocol/registry.json"));
    let records = data_expect<Array<Data>>(data_require<Array<Data>>(root, "methods"));
    let rows = for record in records {
        let name = data_expect<String>(data_require<String>(record, "name"));
        let params = data_expect<String>(data_require<String>(record, "params"));
        let result = data_expect<String>(data_require<String>(record, "result"));
        let summary = data_expect<String>(data_require<String>(record, "summary"));
        row()[
            #cell[#raw(name)]
            #cell[#raw(params)]
            #cell[#raw(result)]
            #cell[#text(text: summary)]
        ]
    };
    table()[
        #row(header: true)[#cell[方法] #cell[参数] #cell[返回] #cell[说明]]
        #rows
    ]
}
