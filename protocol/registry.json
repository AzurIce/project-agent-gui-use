  "methods": [
    {
      "name": "app.list",
      "notes": "默认只返回带 LAUNCHER 入口的包。",
      "params": [
        {
          "description": "是否包含系统应用，默认 false",
          "name": "include_system",
          "required": false,
          "type": "bool?"
        }
      ],
      "params_type": "AppListParams",
      "request": "{\"include_system\": false}",
      "response": "{\"apps\": [{\"package_name\": \"com.tencent.mm\", \"label\": \"微信\", \"launchable\": true}]}",
      "result": [
        {
          "description": "",
          "name": "apps",
          "required": true,
          "type": "AppInfo[]"
        }
      ],
      "result_type": "AppListResult",
      "summary": "列出可启动的应用"
    },
    {
      "name": "app.launch",
      "notes": "返回只表示请求已被接受，真正成功以 `ui.window_changed` 为准。",
      "params": [
        {
          "description": "指定 Activity，省略则用 LAUNCHER 入口",
          "name": "activity",
          "required": false,
          "type": "string?"
        },
        {
          "description": "启动前是否强制停止",
          "name": "force_stop",
          "required": false,
          "type": "bool?"
        },
        {
          "description": "",
          "name": "package_name",
          "required": true,
          "type": "string"
        }
      ],
      "params_type": "AppLaunchParams",
      "request": "{\"package_name\": \"com.tencent.mm\"}",
      "response": "{\"accepted\": true}",
      "result": [
        {
          "description": "",
          "name": "accepted",
          "required": true,
          "type": "bool"
        }
      ],
      "result_type": "AppLaunchResult",
      "summary": "启动应用"
    },
    {
      "name": "ui.snapshot",
      "notes": "`seq` 对应该次快照观察到的最后一个事件序号。节点 id 只在本次快照内有效，跨快照需要按指纹重新匹配。",
      "params": [
        {
          "description": "`actionable` 或 `all`，默认 `actionable`",
          "name": "filter",
          "required": false,
          "type": "string?"
        },
        {
          "description": "节点上限，默认 800",
          "name": "max_nodes",
          "required": false,
          "type": "int?"
        }
      ],
      "params_type": "UiSnapshotParams",
      "request": "{\"filter\": \"actionable\"}",
      "response": "{\"seq\": 42, \"package_name\": \"com.tencent.mm\", \"activity\": \".ui.LauncherUI\", \"truncated\": false, \"nodes\": []}",
      "result": [
        {
          "description": "",
          "name": "activity",
          "required": true,
          "type": "string"
        },
        {
          "description": "",
          "name": "nodes",
          "required": true,
          "type": "Node[]"
        },
        {
          "description": "",
          "name": "package_name",
          "required": true,
          "type": "string"
        },
        {
          "description": "",
          "name": "seq",
          "required": true,
          "type": "int"
        },
        {
          "description": "",
          "name": "truncated",
          "required": true,
          "type": "bool"
        }
      ],
      "result_type": "UiSnapshotResult",
      "summary": "读取当前窗口的节点树"
    },
    {
      "name": "ui.act",
      "notes": "执行顺序为节点动作、最近的可操作祖先、坐标手势。节点动作不被支持时返回 `2002`。",
      "params": [
        {
          "description": "`click`、`long_click`、`set_text`、`clear_text`、`focus`、`scroll_forward`、`scroll_backward`、`select`",
          "name": "action",
          "required": true,
          "type": "string"
        },
        {
          "description": "",
          "name": "node",
          "required": true,
          "type": "string"
        },
        {
          "description": "`set_text` 使用",
          "name": "text",
          "required": false,
          "type": "string?"
        }
      ],
      "params_type": "UiActParams",
      "request": "{\"node\": \"n7\", \"action\": \"click\"}",
      "response": "{\"changed\": true}",
      "result": [
        {
          "description": "",
          "name": "changed",
          "required": true,
          "type": "bool"
        }
      ],
      "result_type": "UiActResult",
      "summary": "按节点执行语义动作"
    },
    {
      "name": "ui.gesture",
      "notes": "同一手势最多 10 个 stroke，总时长不超过 60 秒。",
      "params": [
        {
          "description": "",
          "name": "strokes",
          "required": true,
          "type": "GestureStroke[]"
        },
        {
          "description": "",
          "name": "timeout_ms",
          "required": false,
          "type": "int?"
        }
      ],
      "params_type": "UiGestureParams",
      "request": "{\"strokes\": [{\"points\": [{\"x\": 540, \"y\": 1800}, {\"x\": 540, \"y\": 600}], \"duration_ms\": 300}]}",
      "response": "{\"performed\": true}",
      "result": [
        {
          "description": "",
          "name": "performed",
          "required": true,
          "type": "bool"
        }
      ],
      "result_type": "UiGestureResult",
      "summary": "执行原始手势"
    },
    {
      "name": "ui.wait",
      "notes": "`idle` 表示连续 300 毫秒没有新的界面事件。",
      "params": [
        {
          "description": "",
          "name": "timeout_ms",
          "required": false,
          "type": "int?"
        },
        {
          "description": "`idle`、`window` 或 `text`",
          "name": "until",
          "required": true,
          "type": "string"
        },
        {
          "description": "`window` 时为包名，`text` 时为子串",
          "name": "value",
          "required": false,
          "type": "string?"
        }
      ],
      "params_type": "UiWaitParams",
      "request": "{\"until\": \"idle\", \"timeout_ms\": 5000}",
      "response": "{\"matched\": true}",
      "result": [
        {
          "description": "",
          "name": "matched",
          "required": true,
          "type": "bool"
        }
      ],
      "result_type": "UiWaitResult",
      "summary": "等待界面进入稳定状态"
    },
    {
      "name": "ui.screenshot",
      "notes": "返回二进制帧而不是 base64。",
      "params": [
        {
          "description": "缩放上限，默认不缩放",
          "name": "max_width",
          "required": false,
          "type": "int?"
        }
      ],
      "params_type": "UiScreenshotParams",
      "request": "{\"max_width\": 720}",
      "response": "{\"mime\": \"image/png\", \"width\": 540, \"height\": 1200, \"bytes\": 184320}",
      "result": [
        {
          "description": "",
          "name": "bytes",
          "required": true,
          "type": "int"
        },
        {
          "description": "",
          "name": "height",
          "required": true,
          "type": "int"
        },
        {
          "description": "",
          "name": "mime",
          "required": true,
          "type": "string"
        },
        {
          "description": "",
          "name": "width",
          "required": true,
          "type": "int"
        }
      ],
      "result_type": "UiScreenshotInfo",
      "summary": "抓取一帧画面"
    },
    {
      "name": "notification.list",
      "notes": "没有历史回填，服务启用之前发生的事看不到。",
      "params": [
        {
          "description": "",
          "name": "limit",
          "required": false,
          "type": "int?"
        }
      ],
      "params_type": "NotificationListParams",
      "request": "{\"limit\": 20}",
      "response": "{\"notifications\": [{\"key\": \"0|com.tencent.mm|1|null|10001\", \"package_name\": \"com.tencent.mm\", \"title\": \"小明\", \"text\": \"明天几点出发？\", \"posted_at\": \"2026-11-12T01:23:45.678Z\", \"ongoing\": false, \"actions\": []}]}",
      "result": [
        {
          "description": "",
          "name": "notifications",
          "required": true,
          "type": "NotificationInfo[]"
        }
      ],
      "result_type": "NotificationListResult",
      "summary": "读取当前活跃通知"
    },
    {
      "name": "notification.reply",
      "notes": "不打开界面。",
      "params": [
        {
          "description": "默认为第一个带 remote input 的 action",
          "name": "action_index",
          "required": false,
          "type": "int?"
        },
        {
          "description": "",
          "name": "key",
          "required": true,
          "type": "string"
        },
        {
          "description": "",
          "name": "text",
          "required": true,
          "type": "string"
        }
      ],
      "params_type": "NotificationReplyParams",
      "request": "{\"key\": \"0|com.tencent.mm|1|null|10001\", \"text\": \"八点\"}",
      "response": "{\"sent\": true}",
      "result": [
        {
          "description": "",
          "name": "sent",
          "required": true,
          "type": "bool"
        }
      ],
      "result_type": "NotificationReplyResult",
      "summary": "通过通知自带的 RemoteInput 回复"
    }
  ],
